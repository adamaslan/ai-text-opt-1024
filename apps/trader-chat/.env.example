# trader-chat lives in apps/trader-chat/ but reads from the monorepo root .env.
# Copy this file to ai-text-opt-1024/.env (two levels up) and fill in keys.
#
# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Shares the collection already ingested by ai-text-opt-1024
CHROMA_MODE=local                      # "local" | "cloud"
CHROMA_COLLECTION=ideas_1024d
CHROMA_COLLECTION_VERSION=2

# Cloud upgrade — set these when CHROMA_MODE=cloud
# CHROMA_API_KEY=<your-chroma-api-key>
# CHROMA_TENANT=<your-tenant-name>
# CHROMA_DATABASE=<your-database-name>

# ── Embed service (shared with ai-text-opt-1024) ──────────────────────────────
EMBED_SERVICE_URL=http://127.0.0.1:8001

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=<your-openrouter-api-key>
# Optional comma-separated override of the free-model fallback chain
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free

# ── RAG tuning ────────────────────────────────────────────────────────────────
RAG_TOP_K=8
RAG_MAX_TOP_K=20
RAG_SCORE_THRESHOLD=0.75

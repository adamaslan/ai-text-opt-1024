# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_MODE=local                      # "local" | "cloud"
CHROMA_COLLECTION=ideas_1024d

# Cloud upgrade — set these three when CHROMA_MODE=cloud
# CHROMA_API_KEY=<your-chroma-api-key>
# CHROMA_TENANT=<your-tenant-name>
# CHROMA_DATABASE=<your-database-name>

# Cost guardrails (cloud mode only)
CHROMA_BUDGET_SOFT=5.00                # abort ingest if projected write > this ($)
CHROMA_BUDGET_HARD=20.00               # hard ceiling for any single operation ($)

# Collection versioning (increment to roll forward, decrement to rollback).
# IMPORTANT: bump to 2 after the chunk-size change (480/300 vs old 400) —
# new chunk boundaries invalidate all old content_hashes so every chunk
# re-embeds. A fresh versioned collection lets you roll back if recall regresses.
CHROMA_COLLECTION_VERSION=2

# ── Ingest checkpoint (mode-scoped) ──────────────────────────────────────────
# Checkpoint files default to data/ingest.{CHROMA_MODE}.checkpoint.json so
# local and cloud runs never share state. Override with CHECKPOINT_FILE if
# you need a custom path (e.g. for testing).
# CHECKPOINT_FILE=data/ingest.local.checkpoint.json

# ── Embedding (Python ingest + embed-service) ─────────────────────────────────
EMBEDDING_MODEL=intfloat/e5-large-v2
EMBEDDING_BATCH_SIZE=32

# ── Chunking (file-type aware) ────────────────────────────────────────────────
# Prose files (doc-*, swing-*, *-outline). e5-large-v2 hard cap is 512 tokens.
PROSE_CHUNK_SIZE=480
PROSE_CHUNK_OVERLAP=96
# Q&A files (t1-*, t2-*, *-qa.md, *-100-questions). Atomic units, smaller chunks.
QA_CHUNK_SIZE=300
QA_CHUNK_OVERLAP=40
# Drop chunks shorter than this many tokens (~4 chars per token) to skip stubs.
MIN_CHUNK_TOKENS=80

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                    # "gemini" | "mistral"
GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-2.5-flash        # optional override
# MISTRAL_API_KEY=<your-mistral-api-key>
# MISTRAL_MODEL=mistral-small-latest

# ── RAG tuning ───────────────────────────────────────────────────────────────
RAG_TOP_K=10
RAG_MAX_TOP_K=50                       # hard cap — prevents accidental large fetches
RAG_SCORE_THRESHOLD=0.75

# ── Embed service ─────────────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://127.0.0.1:8001

# ── GCP3 Backend (swing predictions, inherited from nu-finance) ───────────────
GCP3_BACKEND_URL=http://localhost:8080

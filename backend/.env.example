# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_MODE=local
CHROMA_COLLECTION=ideas_1024d
CHROMA_COLLECTION_VERSION=2
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# ── Embed service ─────────────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://127.0.0.1:8001

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=<your-openrouter-api-key>
# Optional comma-separated override of the free-model fallback chain
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free

# ── RAG tuning ───────────────────────────────────────────────────────────────
RAG_TOP_K=10
RAG_MAX_TOP_K=50
RAG_SCORE_THRESHOLD=0.75
